# ==========================================
# Multilingual Chatbot Environment Variables
# ==========================================

# 1. LLM Provider Configuration
# Choose: "google" or "openai" or "mock" (for offline local development)
LLM_PROVIDER=google

# Google Gemini API Key (If LLM_PROVIDER=google)
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI API Key (If LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# 2. Rasa & Action Server URLs
RASA_SERVER_URL=http://localhost:5005
ACTION_SERVER_URL=http://localhost:5055

# 3. Multilingual Settings
DEFAULT_LANGUAGE=en
FALLBACK_CONFIDENCE_THRESHOLD=0.60
